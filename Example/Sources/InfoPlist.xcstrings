    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُستخدم موقعك لتسجيل المكان الذي التُقطت فيه الصور التي تلتقطها في العرض التوضيحي لـ CameraFlow."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Местоположението ви се използва, за да се записва къде са направени снимките, които правите в демото на CameraFlow."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaše poloha slouží k zaznamenání místa, kde byly pořízeny fotky, které vyfotíte v ukázce CameraFlow."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din lokalitet bruges til at registrere, hvor de fotos, du tager i CameraFlow-demoen, blev taget."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Standort wird verwendet, um festzuhalten, wo die Fotos aufgenommen wurden, die du in der CameraFlow-Demo aufnimmst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η τοποθεσία σας χρησιμοποιείται για την καταγραφή του σημείου όπου τραβήχτηκαν οι φωτογραφίες που τραβάτε στην επίδειξη του CameraFlow."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your location is used to record where the photos you take in the camera flow demo were taken."
