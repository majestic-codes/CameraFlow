        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu ubicación se usa para registrar dónde se hicieron las fotos que haces en la demo de CameraFlow."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu ubicación se usa para registrar dónde se tomaron las fotos que tomas en la demo de CameraFlow."
