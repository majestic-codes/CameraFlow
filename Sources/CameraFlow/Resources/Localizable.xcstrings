          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपनी पूरी लाइब्रेरी का ऐक्सेस दिए बिना तस्वीरें चुनें।"
          }
        },
        "hr" : {
          "stringUnit" : {
