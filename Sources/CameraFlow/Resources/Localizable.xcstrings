    "onboarding.location.footnote" : {
      "comment" : "Small print above the Continue button of the location introduction: the system request for location access follows. Settings is the system Settings app, written as the system names it.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيُطلب منك بعد ذلك السماح بالوصول إلى الموقع. يمكنك تغيير ذلك في أي وقت من الإعدادات."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "След това ще бъде поискан достъп до местоположението. Можете да го промените по всяко време в Настройки."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V dalším kroku se zobrazí žádost o přístup k poloze. Kdykoli ho můžete změnit v Nastavení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bliver nu bedt om adgang til lokalitet. Det kan altid ændres i Indstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als Nächstes wirst du nach dem Zugriff auf deinen Standort gefragt. Du kannst dies jederzeit in den Einstellungen ändern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στη συνέχεια, θα σας ζητηθεί πρόσβαση στην τοποθεσία. Μπορείτε να την αλλάξετε ανά πάσα στιγμή στις Ρυθμίσεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You’ll be asked for location access next. You can change it anytime in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A continuación se te pedirá acceso a la ubicación. Puedes cambiarlo en cualquier momento en Ajustes."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A continuación se te pedirá acceso a la ubicación. Puedes cambiarlo en cualquier momento en Configuración."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Järgmisena küsitakse juurdepääsu asukohale. Saad seda igal ajal muuta rakenduses Seaded."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuraavaksi sinulta pyydetään lupaa käyttää sijaintia. Voit muuttaa valintaa milloin tahansa Asetuksissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès à la position vous sera ensuite demandé. Vous pouvez le modifier à tout moment dans Réglages."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בשלב הבא תופיע בקשה לגישה לפרטי המיקום. ניתן לשנות זאת בכל עת ב״הגדרות״."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आगे आपसे स्थान ऐक्सेस माँगा जाएगा। आप इसे सेटिंग में कभी भी बदल सकते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatim ćete dobiti upit za pristup lokaciji. To možete promijeniti u bilo kojem trenutku u Postavkama."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A következő lépésben a rendszer engedélyt kér a helyzetéhez való hozzáféréshez. Ezt bármikor módosíthatja a Beállításokban."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berikutnya, Anda akan dimintai akses lokasi. Anda dapat mengubahnya kapan saja di Pengaturan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ora ti verrà chiesto l’accesso alla posizione. Puoi modificarlo in qualsiasi momento in Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次に位置情報へのアクセスを求められます。“設定”でいつでも変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다음 단계에서 위치 접근 권한을 요청합니다. 설정에서 언제든지 변경할 수 있습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toliau būsite paprašyti suteikti prieigą prie vietos. Tai bet kada galite pakeisti „Nustatymuose“."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tālāk tiks lūgta piekļuve atrašanās vietai. To jebkurā laikā varat mainīt lietotnē Iestatījumi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du blir nå bedt om tilgang til posisjonen din. Du kan endre dette når som helst i Innstillinger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hierna wordt om toegang tot je locatie gevraagd. Dit kun je altijd wijzigen in Instellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za chwilę pojawi się prośba o dostęp do położenia. Możesz to zmienić w dowolnej chwili w Ustawieniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A seguir, será solicitado o acesso à localização. Você pode alterar isso a qualquer momento nos Ajustes."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A seguir, ser-lhe-á pedido o acesso à localização. Pode alterá-lo em qualquer altura nas Definições."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "În continuare vi se va solicita accesul la localizare. Îl puteți modifica oricând în Configurări."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Далее появится запрос на доступ к геопозиции. Его можно изменить в любое время в Настройках."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V ďalšom kroku sa zobrazí žiadosť o prístup k polohe. Kedykoľvek ho môžete zmeniť v Nastaveniach."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Härnäst får du en fråga om åtkomst till platsinformation. Detta kan när som helst ändras i Inställningar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถัดไปคุณจะถูกขอสิทธิ์การเข้าถึงตำแหน่งที่ตั้ง คุณเปลี่ยนแปลงได้ทุกเมื่อในการตั้งค่า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birazdan konum erişimi izni istenecek. Bunu istediğiniz zaman Ayarlar’da değiştirebilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Далі зʼявиться запит на доступ до геопозиції. Його можна будь-коли змінити в Параметрах."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiếp theo, bạn sẽ được yêu cầu cấp quyền truy cập vị trí. Bạn có thể thay đổi bất cứ lúc nào trong Cài đặt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接下来将请求位置访问权限。你可以随时在“设置”中更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接下來會要求取用位置。你隨時可以在「設定」中更改。"
          }
        }
      }
    },
    "onboarding.location.inUse.detail" : {
      "comment" : "Row detail under “Only While in Use”.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
