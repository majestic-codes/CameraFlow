    "onboarding.library.copy.detail" : {
      "comment" : "One line under the row title “Keep a Copy” of the photo library introduction.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الصور التي تلتقطها هنا يمكن حفظها أيضًا في مكتبة صورك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Снимките, направени тук, може да се запазват и във вашата фотобиблиотека."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotky pořízené zde lze ukládat také do knihovny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos, du tager her, kan også gemmes i dit bibliotek."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos, die du hier aufnimmst, können auch in deiner Mediathek gesichert werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι φωτογραφίες που τραβάτε εδώ μπορούν να αποθηκεύονται και στη βιβλιοθήκη σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photos you take here can also be saved to your library."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las fotos que hagas aquí también se pueden guardar en tu fototeca."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las fotos que tomes aquí también se pueden guardar en tu fototeca."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siin tehtud fotod saab salvestada ka sinu fototeeki."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Täällä ottamasi kuvat voidaan tallentaa myös kirjastoosi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les photos prises ici peuvent aussi être enregistrées dans votre photothèque."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ניתן לשמור בספריה שלך גם תמונות שצולמו כאן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यहाँ ली गई तस्वीरें आपकी लाइब्रेरी में भी सहेजी जा सकती हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotografije koje ovdje snimite mogu se spremiti i u vašu medijateku."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az itt készített fotók a könyvtárába is menthetők."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foto yang Anda ambil di sini juga dapat disimpan ke perpustakaan Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
