    "camera.flashDisabled.heat.iPad" : {
      "comment" : "Message of the alert titled camera.flashDisabled.title on iPad: the iPad is too hot for the flash, as the system Camera words it. VoiceOver also reads it as the hint of the Flash control meanwhile.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج iPad أن يُترك ليبرد قبل استخدام الفلاش."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad трябва да се охлади, преди да можете да използвате светкавицата."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad potřebuje před použitím blesku vychladnout."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad skal køle af, før du kan bruge blitz."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das iPad muss abkühlen, bevor der Blitz benutzt werden kann."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το iPad πρέπει να κρυώσει για να χρησιμοποιήσετε το φλας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad needs to cool down before you can use the flash."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La temperatura del iPad debe bajar antes de poder usar el flash."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El iPad debe enfriarse antes de que puedas usar el flash."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad peab enne välgu kasutamist jahtuma."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPadin on jäähdyttävä ennen kuin voit käyttää salamaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attendez que l’iPad refroidisse pour pouvoir utiliser le flash."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "על ה-iPad להתקרר לפני שניתן יהיה להשתמש בפלאש."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़्लैश का इस्तेमाल करने से पहले ज़रूरी है कि iPad को ठंडा होने दिया जाए।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad se treba ohladiti kako biste mogli koristiti bljeskalicu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az iPadnek le kell hűlnie, mielőtt a vakut használni lehetne."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad harus mendingin sebelum Anda dapat menggunakan kilat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad deve raffreddarsi prima che sia possibile utilizzare il flash."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPadの本体温度が下がるまでフラッシュは使用できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "플래시를 사용하기 전에 iPad의 온도를 낮춰야 합니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prieš naudojant blykstę „iPad“ turi atvėsti."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad planšetdatoram ir jāatdziest, pirms varat izmantot zibspuldzi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPaden må avkjøles før du kan bruke blitsen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De iPad moet afkoelen voordat je de flits kunt gebruiken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby użyć lampy błyskowej, musisz schłodzić iPada."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para usar o flash, primeiro o iPad precisa esfriar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de poder utilizar o flash, o iPad tem de arrefecer."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad‑ul trebuie să se răcească înainte de a putea utiliza blițul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перед использованием вспышки iPad должен остыть."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad sa potrebuje pred použitím blesku ochladiť."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad måste svalna innan du kan använda blixten."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ต้องให้ iPad เย็นลงก่อนคุณถึงจะสามารถใช้แฟลชได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flaşı kullanabilmeniz için iPad’in soğuması gerekiyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad повинен охолонути, перш ніж використовувати спалах."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad cần hạ nhiệt trước khi bạn có thể sử dụng đèn flash."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad需先降温才能使用闪光灯。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad冷卻後才能再度使用閃光燈。"
          }
        }
      }
    },
