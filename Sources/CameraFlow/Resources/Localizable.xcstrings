    "onboarding.location.optional.detail" : {
      "comment" : "Row detail under “Your Choice”.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دون الوصول إلى الموقع، تُلتقط الصور كالمعتاد."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без достъп до местоположението снимките се правят по същия начин."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez přístupu k poloze se fotí úplně stejně."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uden adgang til lokalitet tages fotos på samme måde."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auch ohne Zugriff auf den Standort kannst du ganz normal Fotos aufnehmen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χωρίς πρόσβαση στην τοποθεσία, οι φωτογραφίες τραβιούνται κανονικά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without location access, photos are taken just the same."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin acceso a la ubicación, las fotos se hacen igual."
