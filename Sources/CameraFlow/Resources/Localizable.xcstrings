    "onboarding.camera.footnote" : {
      "comment" : "Small print above the Continue button of the camera introduction. Settings is the system Settings app, written as the system names it.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيُطلب منك بعد ذلك السماح بالوصول إلى الكاميرا. يمكنك تغيير ذلك في أي وقت من الإعدادات."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "След това ще бъде поискан достъп до камерата. Можете да го промените по всяко време в Настройки."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V dalším kroku se zobrazí žádost o přístup k fotoaparátu. Kdykoli ho můžete změnit v Nastavení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bliver nu bedt om adgang til kameraet. Det kan altid ændres i Indstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als Nächstes wirst du nach dem Zugriff auf die Kamera gefragt. Du kannst dies jederzeit in den Einstellungen ändern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στη συνέχεια, θα σας ζητηθεί πρόσβαση στην κάμερα. Μπορείτε να την αλλάξετε ανά πάσα στιγμή στις Ρυθμίσεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You’ll be asked for camera access next. You can change it anytime in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A continuación se te pedirá acceso a la cámara. Puedes cambiarlo en cualquier momento en Ajustes."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A continuación se te pedirá acceso a la cámara. Puedes cambiarlo en cualquier momento en Configuración."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Järgmisena küsitakse juurdepääsu kaamerale. Saad seda igal ajal muuta rakenduses Seaded."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuraavaksi sinulta pyydetään lupaa käyttää kameraa. Voit muuttaa valintaa milloin tahansa Asetuksissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès à la caméra vous sera ensuite demandé. Vous pouvez le modifier à tout moment dans Réglages."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בשלב הבא תופיע בקשה לגישה למצלמה. ניתן לשנות זאת בכל עת ב״הגדרות״."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आगे आपसे कैमरा ऐक्सेस माँगा जाएगा। आप इसे सेटिंग में कभी भी बदल सकते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatim ćete dobiti upit za pristup kameri. To možete promijeniti u bilo kojem trenutku u Postavkama."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A következő lépésben a rendszer engedélyt kér a kamerához való hozzáféréshez. Ezt bármikor módosíthatja a Beállításokban."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berikutnya, Anda akan dimintai akses kamera. Anda dapat mengubahnya kapan saja di Pengaturan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ora ti verrà chiesto l’accesso alla fotocamera. Puoi modificarlo in qualsiasi momento in Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次にカメラへのアクセスを求められます。“設定”でいつでも変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다음 단계에서 카메라 접근 권한을 요청합니다. 설정에서 언제든지 변경할 수 있습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toliau būsite paprašyti suteikti prieigą prie kameros. Tai bet kada galite pakeisti „Nustatymuose“."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tālāk tiks lūgta piekļuve kamerai. To jebkurā laikā varat mainīt lietotnē Iestatījumi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du blir nå bedt om tilgang til kameraet. Du kan endre dette når som helst i Innstillinger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hierna wordt om toegang tot de camera gevraagd. Dit kun je altijd wijzigen in Instellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za chwilę pojawi się prośba o dostęp do aparatu. Możesz to zmienić w dowolnej chwili w Ustawieniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A seguir, será solicitado o acesso à câmera. Você pode alterar isso a qualquer momento nos Ajustes."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A seguir, ser-lhe-á pedido o acesso à câmara. Pode alterá-lo em qualquer altura nas Definições."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "În continuare vi se va solicita accesul la cameră. Îl puteți modifica oricând în Configurări."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Далее появится запрос на доступ к камере. Его можно изменить в любое время в Настройках."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V ďalšom kroku sa zobrazí žiadosť o prístup ku kamere. Kedykoľvek ho môžete zmeniť v Nastaveniach."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Härnäst får du en fråga om åtkomst till kameran. Detta kan när som helst ändras i Inställningar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถัดไปคุณจะถูกขอสิทธิ์การเข้าถึงกล้อง คุณเปลี่ยนแปลงได้ทุกเมื่อในการตั้งค่า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birazdan kamera erişimi izni istenecek. Bunu istediğiniz zaman Ayarlar’da değiştirebilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Далі зʼявиться запит на доступ до камери. Його можна будь-коли змінити в Параметрах."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiếp theo, bạn sẽ được yêu cầu cấp quyền truy cập camera. Bạn có thể thay đổi bất cứ lúc nào trong Cài đặt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接下来将请求相机访问权限。你可以随时在“设置”中更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接下來會要求取用相機。你隨時可以在「設定」中更改。"
          }
        }
      }
    },
    "onboarding.camera.picker.detail" : {
      "comment" : "One line under the row title “Choose From Library”: the system photo picker shows the app only the photos the user picks, so no library access is asked for.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر الصور دون منح حق الوصول إلى مكتبتك بالكامل."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Избирайте снимки, без да давате достъп до цялата си фотобиблиотека."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vybírejte fotky, aniž byste zpřístupnili celou knihovnu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg fotos uden at give adgang til hele dit bibliotek."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle Fotos aus, ohne Zugriff auf deine gesamte Mediathek zu gewähren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιλέξτε φωτογραφίες χωρίς να δώσετε πρόσβαση σε ολόκληρη τη βιβλιοθήκη σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick photos without giving access to your whole library."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige fotos sin dar acceso a toda tu fototeca."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige fotos sin dar acceso a toda tu fototeca."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vali fotod ilma kogu fototeegile juurdepääsu andmata."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse kuvia antamatta käyttöoikeutta koko kirjastoosi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez des photos sans donner accès à toute votre photothèque."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
