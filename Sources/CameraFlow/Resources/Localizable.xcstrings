            "value" : "За запазване на снимки в албум е нужен достъп до вашата фотобиблиотека."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukládání fotek do alba vyžaduje přístup k vaší knihovně."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det kræver adgang til dit bibliotek at gemme fotos i et album."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Sichern von Fotos in einem Album ist Zugriff auf deine Mediathek erforderlich."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
