    "onboarding.library.footnote" : {
      "comment" : "Small print above the Continue button of the photo library introduction. Settings is the system Settings app, written as the system names it.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيُطلب منك بعد ذلك السماح بالوصول إلى مكتبة الصور. يمكنك تغيير ذلك في أي وقت من الإعدادات."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "След това ще бъде поискан достъп до фотобиблиотеката. Можете да го промените по всяко време в Настройки."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V dalším kroku se zobrazí žádost o přístup ke knihovně fotek. Kdykoli ho můžete změnit v Nastavení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bliver nu bedt om adgang til dit fotobibliotek. Det kan altid ændres i Indstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als Nächstes wirst du nach dem Zugriff auf deine Fotomediathek gefragt. Du kannst dies jederzeit in den Einstellungen ändern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στη συνέχεια, θα σας ζητηθεί πρόσβαση στη βιβλιοθήκη φωτογραφιών. Μπορείτε να την αλλάξετε ανά πάσα στιγμή στις Ρυθμίσεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You’ll be asked for photo library access next. You can change it anytime in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A continuación se te pedirá acceso a la fototeca. Puedes cambiarlo en cualquier momento en Ajustes."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A continuación se te pedirá acceso a la fototeca. Puedes cambiarlo en cualquier momento en Configuración."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Järgmisena küsitakse juurdepääsu fototeegile. Saad seda igal ajal muuta rakenduses Seaded."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuraavaksi sinulta pyydetään lupaa käyttää kuvakirjastoa. Voit muuttaa valintaa milloin tahansa Asetuksissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès à la photothèque vous sera ensuite demandé. Vous pouvez le modifier à tout moment dans Réglages."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בשלב הבא תופיע בקשה לגישה לספריית התמונות. ניתן לשנות זאת בכל עת ב״הגדרות״."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आगे आपसे तस्वीर लाइब्रेरी ऐक्सेस माँगा जाएगा। आप इसे सेटिंग में कभी भी बदल सकते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatim ćete dobiti upit za pristup medijateci fotografija. To možete promijeniti u bilo kojem trenutku u Postavkama."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A következő lépésben a rendszer engedélyt kér a fotókönyvtárhoz való hozzáféréshez. Ezt bármikor módosíthatja a Beállításokban."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berikutnya, Anda akan dimintai akses perpustakaan foto. Anda dapat mengubahnya kapan saja di Pengaturan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ora ti verrà chiesto l’accesso alla libreria foto. Puoi modificarlo in qualsiasi momento in Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次に写真ライブラリへのアクセスを求められます。“設定”でいつでも変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다음 단계에서 사진 보관함 접근 권한을 요청합니다. 설정에서 언제든지 변경할 수 있습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toliau būsite paprašyti suteikti prieigą prie nuotraukų bibliotekos. Tai bet kada galite pakeisti „Nustatymuose“."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tālāk tiks lūgta piekļuve fotoattēlu bibliotēkai. To jebkurā laikā varat mainīt lietotnē Iestatījumi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du blir nå bedt om tilgang til bildebiblioteket. Du kan endre dette når som helst i Innstillinger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hierna wordt om toegang tot je fotobibliotheek gevraagd. Dit kun je altijd wijzigen in Instellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za chwilę pojawi się prośba o dostęp do biblioteki zdjęć. Możesz to zmienić w dowolnej chwili w Ustawieniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A seguir, será solicitado o acesso à fototeca. Você pode alterar isso a qualquer momento nos Ajustes."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A seguir, ser-lhe-á pedido o acesso à fototeca. Pode alterá-lo em qualquer altura nas Definições."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "În continuare vi se va solicita accesul la biblioteca foto. Îl puteți modifica oricând în Configurări."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Далее появится запрос на доступ к медиатеке. Его можно изменить в любое время в Настройках."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V ďalšom kroku sa zobrazí žiadosť o prístup ku knižnici fotiek. Kedykoľvek ho môžete zmeniť v Nastaveniach."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Härnäst får du en fråga om åtkomst till bildbiblioteket. Detta kan när som helst ändras i Inställningar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถัดไปคุณจะถูกขอสิทธิ์การเข้าถึงคลังรูปภาพ คุณเปลี่ยนแปลงได้ทุกเมื่อในการตั้งค่า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birazdan fotoğraf arşivi erişimi izni istenecek. Bunu istediğiniz zaman Ayarlar’da değiştirebilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Далі зʼявиться запит на доступ до фототеки. Його можна будь-коли змінити в Параметрах."
          }
        },
        "vi" : {
          "stringUnit" : {
