    },
    "onboarding.library.switch.detail" : {
      "comment" : "One line under the row title “You’re in Control” of the photo library introduction.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شغّل الحفظ أو أوقفه في أي وقت من الكاميرا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
