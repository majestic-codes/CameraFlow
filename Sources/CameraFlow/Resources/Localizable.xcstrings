    "onboarding.camera.review.detail" : {
      "comment" : "One line under the row title “Review and Mark Up” of the camera introduction.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "راجع كل صورة وارسم عليها قبل الانتهاء."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверете всяка снимка и рисувайте върху нея, преди да приключите."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Před dokončením každou fotku zkontrolujte a kreslete do ní."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tjek hvert foto, og tegn på det, inden du afslutter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe jedes Foto und zeichne darauf, bevor du fertig bist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ελέγξτε κάθε φωτογραφία και σχεδιάστε πάνω της πριν ολοκληρώσετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check each photo and draw on it before you finish."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa cada foto y dibuja sobre ella antes de terminar."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa cada foto y dibuja sobre ella antes de terminar."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrolli enne lõpetamist iga fotot ja joonista sellele."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarkista jokainen kuva ja piirrä siihen ennen kuin lopetat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez chaque photo et dessinez dessus avant de terminer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ניתן לבדוק כל תמונה ולצייר עליה לפני הסיום."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पूरा करने से पहले हर तस्वीर देखें और उस पर ड्रॉ करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provjerite svaku fotografiju i crtajte po njoj prije završetka."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ellenőrizze az egyes fotókat, és rajzoljon rájuk, mielőtt befejezi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Periksa setiap foto dan gambar di atasnya sebelum selesai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla ogni foto e disegnaci sopra prima di terminare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完了する前に、各写真を確認して描き込むことができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "완료하기 전에 각 사진을 확인하고 그 위에 그릴 수 있습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prieš baigdami patikrinkite kiekvieną nuotrauką ir pieškite ant jos."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pirms pabeigšanas pārbaudiet katru fotoattēlu un zīmējiet uz tā."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sjekk hvert bilde og tegn på det før du er ferdig."
          }
        },
