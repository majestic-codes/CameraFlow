        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin acceso a la ubicación, las fotos se toman igual."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ka ilma asukohale juurdepääsuta saad pildistada nagu tavaliselt."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
