    "onboarding.library.addOnly.detail" : {
      "comment" : "One line under the row title “Add Only” of the photo library introduction.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن للتطبيق إضافة الصور لكن لا يمكنه رؤية مكتبة صورك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложението може да добавя снимки, но не вижда вашата фотобиблиотека."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikace může přidávat fotky, ale vaši knihovnu nevidí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appen kan tilføje fotos, men kan ikke se dit bibliotek."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App kann Fotos hinzufügen, aber deine Mediathek nicht sehen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η εφαρμογή μπορεί να προσθέτει φωτογραφίες, αλλά δεν βλέπει τη βιβλιοθήκη σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app can add photos but can’t see your library."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app puede añadir fotos, pero no puede ver tu fototeca."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app puede agregar fotos, pero no puede ver tu fototeca."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rakendus saab fotosid lisada, kuid ei näe sinu fototeeki."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appi voi lisätä kuvia, mutta ei näe kirjastoasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app peut ajouter des photos, mais ne peut pas voir votre photothèque."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "היישום יכול להוסיף תמונות אך אינו יכול לראות את הספריה שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप तस्वीरें जोड़ सकता है, लेकिन आपकी लाइब्रेरी नहीं देख सकता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacija može dodavati fotografije, ali ne vidi vašu medijateku."
