    "onboarding.library.album.detail" : {
      "comment" : "One line under the row title “Saved to an Album” of the photo library introduction.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حفظ الصور في ألبوم يتطلب الوصول إلى مكتبة صورك."
          }
        },
        "bg" : {
          "stringUnit" : {
