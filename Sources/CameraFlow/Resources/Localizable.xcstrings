    "camera.flashDisabled.power.iPad" : {
      "comment" : "Message of the alert titled camera.flashDisabled.title on iPad: the battery is too low for the flash, as the system Camera words it. VoiceOver also reads it as the hint of the Flash control meanwhile.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بطارية iPad منخفضة وتحتاج لشحن حتى تتمكن من استخدام الفلاش."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Батерията на iPad е малко и е необходимо да се зареди, преди да можете да използвате светкавицата."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baterie iPadu je téměř vybitá a před použitím blesku je nutné ji dobít."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad-batteriniveauet er lavt og skal oplades, før du kan bruge blitz."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die iPad-Batterie ist fast leer und muss geladen werden, bevor der Blitz benutzt werden kann."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η στάθμη της μπαταρίας του iPad είναι χαμηλή και πρέπει να φορτιστεί για χρήση του φλας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad battery is low and needs to be charged before you can use the flash."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El iPad tiene poca batería. Cárgalo para poder usar el flash."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La batería del iPad tiene poca energía y debe cargarse antes de que puedas usar el flash."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPadi aku on tühjenemas ja enne välgu kasutamist tuleb seda laadida."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPadin akku on vähissä, ja se on ladattava ennen kuin voit käyttää salamaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La batterie de l’iPad est déchargée et doit être rechargée avant de pouvoir utiliser le flash."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "סוללת ה-iPad חלשה ויש לטעון אותה לפני שניתן יהיה להשתמש בפלאש."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad की बैटरी कम है और फ़्लैश का इस्तेमाल करने से पहले ज़रूरी है कि उसे चार्ज किया जाए।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baterija iPada gotovo je prazna i potrebno ju je napuniti kako biste mogli koristiti bljeskalicu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az iPad akkumulátora kezd lemerülni, és fel kell tölteni, mielőtt a vakut használni lehetne."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baterai iPad lemah dan harus diisi sebelum Anda dapat menggunakan kilat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La batteria di iPad è quasi scarica. Prima di utilizzare il flash, carica il dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPadのバッテリー残量が少なくなっています。充電されるまでフラッシュは使用できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad의 배터리가 부족합니다. 플래시를 사용하려면 배터리를 충전해야 합니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„iPad“ akumuliatorius beveik išeikvotas, todėl prieš naudojant blykstę jį reikia įkrauti."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad planšetdatora akumulatora uzlādes līmenis ir zems, un pirms zibspuldzes izmantošanas akumulators ir jāuzlādē."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPaden har lavt batterinivå og må lades før du kan bruke blitsen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De batterij van de iPad is bijna leeg en moet worden opgeladen voordat je de flits kunt gebruiken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poziom naładowania baterii iPada jest niski. Aby użyć lampy błyskowej, musisz go naładować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A bateria do iPad está fraca e precisa ser carregada antes que você possa usar o flash."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de poder utilizar o flash, a bateria do iPad tem de ser carregada."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bateria iPad‑ului este slabă și trebuie să fie încărcată înainte de a putea utiliza blițul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Аккумулятор iPad разрядился. Зарядите устройство, прежде чем использовать вспышку."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batéria iPadu je takmer vybitá a pred použitím blesku je potrebné ju nabiť."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad-batteriet måste laddas innan du kan använda blixten."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แบตเตอรี่ iPad ต่ำและต้องชาร์จก่อนคุณถึงจะสามารถใช้แฟลชได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad pili azaldı ve flaşı kullanabilmeniz için şarj edilmesi gerekiyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Акумулятор iPad розряджено. Його потрібно зарядити, щоб використовувати спалах."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pin của iPad yếu và cần được sạc trước khi bạn có thể sử dụng đèn flash."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad电量低，需要先充电才能使用闪光灯。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad電量不足，使用閃光燈前必須先充電。"
          }
        }
      }
    },
