          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez pristupa lokaciji fotografije se snimaju jednako."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helyzet-hozzáférés nélkül is ugyanúgy készíthet fotókat."
