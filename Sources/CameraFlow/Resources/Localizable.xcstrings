        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone tālrunim ir jāatdziest, pirms varat izmantot zibspuldzi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhonen må avkjøles før du kan bruke blitsen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De iPhone moet afkoelen voordat je de flits kunt gebruiken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby użyć lampy błyskowej, musisz schłodzić iPhone’a."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para usar o flash, primeiro o iPhone precisa esfriar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de poder utilizar o flash, o iPhone tem de arrefecer."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone‑ul trebuie să se răcească înainte de a putea utiliza blițul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перед использованием вспышки iPhone должен остыть."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone sa potrebuje pred použitím blesku ochladiť."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone måste svalna innan du kan använda blixten."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ต้องให้ iPhone เย็นลงก่อนคุณถึงจะสามารถใช้แฟลชได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flaşı kullanabilmeniz için iPhone’un soğuması gerekiyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone повинен охолонути, перш ніж використовувати спалах."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone cần hạ nhiệt trước khi bạn có thể sử dụng đèn flash."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone需先降温才能使用闪光灯。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone冷卻後才能再度使用閃光燈。"
          }
        }
      }
    },
